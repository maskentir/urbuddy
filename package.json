{
  "name": "urbuddy",
  "private": true,
  "type": "module",
  "description": "urbuddy \u2014 reproducible TypeScript assistant runtime skeleton",
  "version": "0.1.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm cruise && pnpm knip && pnpm format",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node -e \"require('node:fs').cpSync('migrations','dist/migrations',{recursive:true})\" && node tooling/verify-dist.mjs",
    "native:build": "node tooling/build-native.mjs",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "cruise": "depcruise src --config .dependency-cruiser.js",
    "knip": "knip",
    "smoke": "tsx src/bootstrap/main.ts doctor",
    "ink-smoke": "tsx src/bootstrap/main.ts --ink-smoke",
    "smoke:transcribe": "node tooling/smoke-transcribe.mjs",
    "brand": "node tooling/generate-brand.mjs",
    "lab:audio-slice": "tsx --tsconfig lab/audio-slice/tsconfig.json lab/audio-slice/run.tsx",
    "lab:audio-slice:test": "vitest run --config lab/audio-slice/vitest.config.ts",
    "lab:audio-slice:capture": "tsx --tsconfig lab/audio-slice/tsconfig.json lab/audio-slice/capture.tsx",
    "lab:audio-slice:reference": "tsx --tsconfig lab/audio-slice/tsconfig.json lab/audio-slice/tools/capture-reference.ts",
    "doctor": "tsx src/bootstrap/main.ts doctor --json",
    "prebuild": "rm -rf dist",
    "lab:muse-qualification": "tsx --tsconfig lab/audio-slice/tsconfig.json lab/audio-slice/qualification/run-muse.tsx",
    "lab:muse-qualification:fixture": "node lab/audio-slice/qualification/generate-audio.mjs",
    "lab:muse-qualification:evaluate": "tsx --tsconfig lab/audio-slice/tsconfig.json lab/audio-slice/qualification/evaluate.ts"
  },
  "dependencies": {
    "@langchain/core": "1.5.1",
    "@langchain/openai": "1.8.5",
    "better-sqlite3": "13.2.0",
    "commander": "15.1.0",
    "drizzle-orm": "0.45.4",
    "env-paths": "4.0.0",
    "ink": "8.0.0",
    "neverthrow": "8.2.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "strip-ansi": "7.2.0",
    "ts-pattern": "5.9.2",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/ws": "8.18.1",
    "@typescript-eslint/parser": "8.74.0",
    "@vitest/coverage-v8": "5.1.2",
    "dependency-cruiser": "18.9.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-plugin-import-x": "4.18.1",
    "fast-check": "4.11.0",
    "husky": "9.1.7",
    "ink-testing-library": "4.0.0",
    "knip": "6.48.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "tsc-alias": "1.9.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{json,md,js,cjs,mjs,yml,yaml}": [
      "prettier --check"
    ]
  }
}
