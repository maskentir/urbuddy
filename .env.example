# Speech recognition
URBUDDY_STT_PROVIDER=muse
URBUDDY_STT_MODEL=muse-voice-transcribe-1.0

# Translation
URBUDDY_TRANSLATION_PROVIDER=openai
URBUDDY_TRANSLATION_MODEL=gpt-6.1-terra
URBUDDY_TRANSLATION_SOURCE_LANGUAGE=auto
URBUDDY_TRANSLATION_TARGET_LANGUAGE=id

# Provider credentials
URBUDDY_META_API_KEY=
URBUDDY_OPENAI_API_KEY=
